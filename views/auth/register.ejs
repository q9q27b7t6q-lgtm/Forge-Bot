<%- include('../partials/head') %>
<section class="page-hero" style="justify-content:center;text-align:center">
  <div>
    <p class="eyebrow"><%= t('auth.register_eyebrow') %></p>
    <h1><%= t('auth.register_title') %></h1>
    <p class="muted"><%= typeof signupsClosed !== 'undefined' && signupsClosed ? t('auth.signups_closed_lead') : t('auth.register_lead') %></p>
  </div>
</section>
<section class="card glass narrow">
  <% if (typeof signupsClosed !== 'undefined' && signupsClosed) { %>
    <div class="alert alert-error" role="alert"><%= t('auth.signups_closed') %></div>
    <p class="muted center"><%= t('auth.has_account') %> <a href="/login"><%= t('auth.login_link') %></a></p>
  <% } else { %>
  <% if (error) { %>
    <div class="alert alert-error" role="alert"><%= error %></div>
  <% } %>
  <form method="post" action="/register" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label>
      <%= t('auth.email') %>
      <input type="email" name="email" required autocomplete="email" maxlength="254"
             value="<%= escapeHtml(email) %>" />
    </label>
    <label>
      <%= t('auth.password') %> <span class="hint"><%= t('auth.password_hint') %></span>
      <input type="password" name="password" required autocomplete="new-password" minlength="8" maxlength="128" />
    </label>
    <label>
      <%= t('auth.password_confirm') %>
      <input type="password" name="password_confirm" required autocomplete="new-password" minlength="8" maxlength="128" />
    </label>

    <label class="checkbox">
      <input type="checkbox" name="accept_cgv" value="1" required <%= accept_cgv ? 'checked' : '' %> />
      <span><%- t('auth.accept_cgv_html') %></span>
    </label>
    <label class="checkbox">
      <input type="checkbox" name="accept_privacy" value="1" required <%= accept_privacy ? 'checked' : '' %> />
      <span><%- t('auth.accept_privacy_html') %></span>
    </label>
    <label class="checkbox">
      <input type="checkbox" name="waive_withdrawal" value="1" required <%= waive_withdrawal ? 'checked' : '' %> />
      <span><%- t('auth.waive_withdrawal_html') %></span>
    </label>

    <button type="submit" class="btn btn-primary btn-block btn-glow"><%= t('auth.register_btn') %></button>
  </form>
  <p class="muted center"><%= t('auth.has_account') %> <a href="/login"><%= t('auth.login_link') %></a></p>
  <% } %>
</section>
<%- include('../partials/foot') %>
